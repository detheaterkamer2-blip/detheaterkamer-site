---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout
  title="Contact & Mailinglijst"
  description="Neem contact op met De Theaterkamer Amsterdam. Contactgegevens, cursuslocaties en mailinglijst."
  activePage="contact"
  canonicalPath="/contactpagina-dtk/"
  showSidebar={true}
>

<!-- HERO -->
<div class="page-hero">
  <div class="page-hero-label">De Theaterkamer Amsterdam</div>
  <h1>Contact & Mailinglijst</h1>
  <p>Voor vragen over theatercursussen van De Theaterkamer</p>
</div>

<!-- CTA TOP -->
<div class="cta-block">
  <h2>Interesse in een theatercursus?</h2>
  <p>Schrijf je in voor een cursus of meld je aan voor onze mailinglijst om op de hoogte te blijven van nieuwe cursusdata</p>
  <div class="cta-buttons">
    <a href="https://www.formdesk.com/detheaterkamer/Inschrijven_De_Theaterkamer" target="_blank" rel="noopener" class="cta-btn cta-btn-primary">Inschrijven voor een cursus</a>
    <a href="https://laposta.nl/f/sskcvxzdyd9e" target="_blank" rel="noopener" class="cta-btn cta-btn-secondary">Aanmelden mailinglijst</a>
  </div>
</div>

<!-- CONTACT GRID -->
<div class="contact-grid">

  <div class="contact-card">
    <h3>Contactgegevens</h3>
    <p><strong>Contactpersoon:</strong> Gertjan ten Thije</p>
    <p><strong>Telefoon:</strong> 06 2279 5519 (ma t/m vrij 11.00 – 15.00)</p>
    <p><strong>Email:</strong> <a href="mailto:cursussen@detheaterkamer.nl">cursussen@detheaterkamer.nl</a></p>
    <p><strong>KvK:</strong> 34283324 Huis in Danba</p>
    <p><strong>BTW:</strong> NL 171697455 B01</p>
    <p><strong>Bank:</strong> NL26 INGB 0004303248 De Theaterkamer</p>
  </div>

  <div class="contact-card">
    <h3>Post- en bezoekadres</h3>
    <p><em>(alleen op afspraak)</em></p>
    <p><strong>Het Amsterdams Theaterhuis</strong><br>
    Marius van Bouwdijk Bastiaansestraat 54<br>
    1054 SP Amsterdam</p>
    <p><a href="http://www.amsterdamstheaterhuis.nl" target="_blank" rel="noopener">www.amsterdamstheaterhuis.nl</a><br>
    <a href="mailto:info@amsterdamstheaterhuis.nl">info@amsterdamstheaterhuis.nl</a></p>
  </div>

</div>

<!-- LOCATIES -->
<div class="tk-section-title" style="margin-top: 36px;">
  <h2>Onze cursuslocaties</h2>
  <div class="tk-title-bar"></div>
</div>

<div class="contact-grid">

  <div class="location-card">
    <h3>Het Amsterdams Theaterhuis</h3>
    <p>Marius van Bouwdijk Bastiaansestraat 54<br>1054 SP Amsterdam</p>
    <p><a href="http://www.amsterdamstheaterhuis.nl" target="_blank" rel="noopener">www.amsterdamstheaterhuis.nl</a></p>
    <p><a href="mailto:info@amsterdamstheaterhuis.nl">info@amsterdamstheaterhuis.nl</a></p>
    <div style="margin-top: 12px;">
      <iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d2436.3!2d4.8667!3d52.3622!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x47c609e8b0123456%3A0x1234567890abcdef!2sMarius+van+Bouwdijk+Bastiaansestraat+54%2C+Amsterdam!5e0!3m2!1snl!2snl!4v1700000000000!5m2!1snl!2snl" width="100%" height="200" style="border:0; border-radius: 8px;" allowfullscreen="" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
    </div>
  </div>

  <div class="location-card">
    <h3>Theater De Cameleon</h3>
    <p>Derde Kostverlorenkade 35<br>1054 TS Amsterdam</p>
    <p><a href="http://www.decameleon.nl" target="_blank" rel="noopener">www.decameleon.nl</a></p>
    <p><a href="mailto:info@decameleon.nl">info@decameleon.nl</a></p>
    <div style="margin-top: 12px;">
      <iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d2436.3!2d4.8580!3d52.3630!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x47c609e8b0123456%3A0x1234567890abcdef!2sDerde+Kostverlorenkade+35%2C+Amsterdam!5e0!3m2!1snl!2snl!4v1700000000000!5m2!1snl!2snl" width="100%" height="200" style="border:0; border-radius: 8px;" allowfullscreen="" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
    </div>
  </div>

</div>

<!-- OPRICHTER -->
<div class="content-block" style="display: flex; gap: 24px; align-items: center; flex-wrap: wrap;">
  <img src="https://www.detheaterkamer.nl/wp-content/uploads/2021/02/Portret-Gertjan-e1408648880199.jpg" alt="Gertjan ten Thije" style="width: 150px; height: 150px; border-radius: 50%; object-fit: cover; border: 3px solid #2c3e50; flex-shrink: 0;" />
  <div>
    <h2 style="border-bottom: none; padding-bottom: 0;">Gertjan ten Thije</h2>
    <p>Oprichter en docent van De Theaterkamer Amsterdam</p>
  </div>
</div>

</BaseLayout>
