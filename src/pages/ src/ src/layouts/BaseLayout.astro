---
interface Props {
  title: string;
  description?: string;
  activePage?: string;
  showSidebar?: boolean;
  ogTitle?: string;
  canonicalPath?: string;
}

const {
  title,
  description = "De Theaterkamer Amsterdam biedt inspirerende theatercursussen voor volwassenen. Improvisatie, acteren, cabaret en meer.",
  activePage = "",
  showSidebar = true,
  ogTitle,
  canonicalPath = "",
} = Astro.props;

const fullTitle = title.includes("De Theaterkamer") ? title : `${title} | De Theaterkamer Amsterdam`;
const canonical = `https://www.detheaterkamer.nl${canonicalPath}`;
---
<html lang="nl">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />

  <meta property="og:type" content="website" />
  <meta property="og:title" content={ogTitle || fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:locale" content="nl_NL" />
  <meta property="og:site_name" content="De Theaterkamer Amsterdam" />

  <link rel="canonical" href={canonical} />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;500;600;700&family=Poppins:wght@300;400;500;600&display=swap" rel="stylesheet" />

  <title>{fullTitle}</title>
</head>
<body>

<!-- ============ HEADER ============ -->
<header class="site-header">
  <div class="header-inner">
    <a href="/" class="header-logo">
      <img src="https://www.detheaterkamer.nl/wp-content/uploads/2021/01/logo.dtk_.tekst_.jpg" alt="De Theaterkamer Amsterdam - acteercursussen" />
    </a>
    <button class="nav-toggle" aria-label="Menu openen" onclick="document.querySelector('.main-nav').classList.toggle('open')">
      <span></span><span></span><span></span>
    </button>
    <nav class="main-nav">
      <ul class="nav-list">
        <li class={`nav-item${activePage === 'home' ? ' active' : ''}`}><a href="/">Home</a></li>
        <li class={`nav-item has-sub${activePage === 'docenten' ? ' active' : ''}`}>
          <a href="/docenten/">Docenten</a>
        </li>
        <li class={`nav-item has-sub${['wat-is','waarom','vraag-en-antwoord'].includes(activePage) ? ' active' : ''}`}>
          <a href="/wat-is-de-theaterkamer/">Wat is De Theaterkamer?</a>
          <ul class="sub-nav">
            <li><a href="/wat-is-de-theaterkamer/#waarom">Waarom De Theaterkamer?</a></li>
            <li><a href="/wat-is-de-theaterkamer/#vragen">Vraag en Antwoord</a></li>
          </ul>
        </li>
        <li class={`nav-item${activePage === 'contact' ? ' active' : ''}`}><a href="/contactpagina-dtk/">Contact & Mailinglijst</a></li>
      </ul>
    </nav>
  </div>
</header>

<!-- ============ PAGE CONTENT ============ -->
{showSidebar ? (
  <div class="page-layout">
    <main class="main-content">
      <slot />
    </main>
    <aside class="sidebar">
      <div class="sidebar-block sb-mailing">
        <h4>Ja, zet mij op de mailinglijst en mail mij nieuwe data van cursussen</h4>
        <a href="https://laposta.nl/f/sskcvxzdyd9e" target="_blank" rel="noopener" class="sb-btn sb-btn-mail">✉ Mail me nieuwe data van de theatercursussen</a>
      </div>
      <div class="sidebar-block sb-inschrijf">
        <h4>Ik wil me inschrijven</h4>
        <a href="https://www.formdesk.com/detheaterkamer/Inschrijven_De_Theaterkamer" target="_blank" rel="noopener" class="sb-btn sb-btn-inschrijf">Ja, ik wil me inschrijven</a>
      </div>
      <div class="sidebar-block sb-portret">
        <h4>Oprichter en docent Gertjan ten Thije</h4>
        <img src="https://www.detheaterkamer.nl/wp-content/uploads/2021/02/Portret-Gertjan-e1408648880199.jpg" alt="Gertjan ten Thije - oprichter De Theaterkamer" />
      </div>
      <div class="sidebar-block sb-waarom">
        <h4>Waarom De Theaterkamer?</h4>
        <ul>
          <li>Divers aanbod van wel 8 verschillende theatercursussen per week voor alle niveau's en leeftijden</li>
          <li>Kleinschalig en persoonlijk, met oog voor jouw mogelijkheden</li>
          <li>Les in onze eigen theaters: <a href="http://www.amsterdamstheaterhuis.nl" target="_blank" rel="noopener">Het Amsterdams Theaterhuis</a> en <a href="http://www.decameleon.nl" target="_blank" rel="noopener">Theater De Cameleon</a></li>
          <li>Les van zeer bevlogen, professionele en ervaren theaterdocenten</li>
          <li>Hechte groepen, je maakt veel nieuwe vrienden</li>
          <li>Proeflessen mogelijk</li>
        </ul>
      </div>
    </aside>
  </div>
) : (
  <main class="main-content main-full">
    <slot />
  </main>
)}

<!-- ============ FOOTER ============ -->
<footer class="site-footer">
  <div class="footer-inner">
    <div class="footer-col">
      <h4>De Theaterkamer</h4>
      <p>Inspirerende en uitdagende theatercursussen voor volwassenen die willen groeien in acteren, presenteren en persoonlijke ontwikkeling.</p>
    </div>
    <div class="footer-col">
      <h4>Waarom Ons Kiezen</h4>
      <ul>
        <li>✦ Divers aanbod van 8+ theatercursussen voor alle niveau's</li>
        <li>✦ Kleinschalig en persoonlijk</li>
        <li>✦ Les in eigen theaters</li>
        <li>✦ Professionele theaterdocenten</li>
        <li>✦ Hechte groepen en nieuwe vriendschappen</li>
        <li>✦ Proeflessen beschikbaar</li>
      </ul>
    </div>
    <div class="footer-col">
      <h4>Contact</h4>
      <p>Locaties in Amsterdam<br><a href="/contactpagina-dtk/">Zie Contactpagina</a><br><a href="mailto:info@detheaterkamer.nl">info@detheaterkamer.nl</a></p>
    </div>
    <div class="footer-col">
      <h4>Doe Mee!</h4>
      <p>Ontdek jouw toneeltalent en blijf op de hoogte van nieuwe cursussen.</p>
      <a href="https://laposta.nl/f/sskcvxzdyd9e" target="_blank" rel="noopener" class="footer-btn">Nieuwsbrief</a>
      <a href="https://www.formdesk.com/detheaterkamer/Inschrijven_De_Theaterkamer" target="_blank" rel="noopener" class="footer-btn footer-btn-alt">Inschrijven</a>
    </div>
  </div>
  <div class="footer-bottom">
    <p>© <span id="footerYear">2026</span> De Theaterkamer Amsterdam</p>
  </div>
</footer>

<style is:global>
  /* === RESET === */
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
  html { -webkit-font-smoothing: antialiased; scroll-behavior: smooth; overflow-x: hidden; }
  body {
    font-family: 'Poppins', 'Helvetica', Arial, sans-serif;
    color: #333; line-height: 1.6;
    background: #faf8f5;
    margin: 0; overflow-x: hidden;
  }
  h1, h2, h3, h4 { font-family: 'Playfair Display', Georgia, serif; }
  a { color: #cb0c2a; text-decoration: none; }
  a:hover { color: #8b3a5c; }
  img { max-width: 100%; height: auto; }

  /* ============ HEADER ============ */
  .site-header {
    background: #fff;
    border-bottom: 3px solid #e7c654;
    position: sticky; top: 0; z-index: 200;
    box-shadow: 0 2px 8px rgba(0,0,0,0.06);
  }
  .header-inner {
    max-width: 1400px; margin: 0 auto;
    display: flex; align-items: center; justify-content: space-between;
    padding: 16px 24px;
  }
  .header-logo img { height: 130px; width: auto; }
  .main-nav .nav-list {
    display: flex; gap: 6px; list-style: none; align-items: center;
  }
  .nav-item a {
    display: block; padding: 12px 20px; color: #2c3e50;
    font-size: 1.05rem; font-weight: 500; border-radius: 6px;
    transition: all 0.2s ease;
  }
  .nav-item a:hover, .nav-item.active a {
    background: #f4f1ee; color: #8b3a5c;
  }
  .nav-item.has-sub { position: relative; }
  .sub-nav {
    display: none; position: absolute; top: 100%; left: 0;
    background: #fff; border-radius: 8px; box-shadow: 0 8px 24px rgba(0,0,0,0.12);
    min-width: 240px; padding: 8px 0; list-style: none; z-index: 300;
  }
  .nav-item.has-sub:hover .sub-nav { display: block; }
  .sub-nav li a {
    padding: 10px 20px; font-size: 0.95rem; display: block;
    color: #555; border-radius: 0;
  }
  .sub-nav li a:hover { background: #f4f1ee; color: #8b3a5c; }
  .nav-toggle {
    display: none; background: none; border: none; cursor: pointer; padding: 8px;
  }
  .nav-toggle span {
    display: block; width: 26px; height: 2px; background: #2c3e50;
    margin: 6px 0; transition: 0.3s ease;
  }

  /* ============ PAGE LAYOUT ============ */
  .page-layout {
    max-width: 1400px; margin: 0 auto; padding: 24px 24px;
    display: grid; grid-template-columns: 1fr 300px; gap: 36px;
    align-items: start;
  }
  .main-full {
    max-width: 1400px; margin: 0 auto; padding: 24px 24px;
  }

  /* ============ SIDEBAR ============ */
  .sidebar { position: sticky; top: 180px; }
  .sidebar-block {
    background: #fff; border-radius: 10px; padding: 20px;
    margin-bottom: 16px; box-shadow: 0 2px 8px rgba(0,0,0,0.06);
    border: 1px solid #e8e2da;
  }
  .sidebar-block h4 {
    font-size: 1rem; color: #2c3e50; margin-bottom: 12px; line-height: 1.4;
  }
  .sb-btn {
    display: block; text-align: center; padding: 12px 16px; border-radius: 8px;
    font-weight: 600; font-size: 0.9rem; transition: all 0.25s ease;
  }
  .sb-btn-mail { background: #2c3e50; color: #fff; }
  .sb-btn-mail:hover { background: #1a252f; color: #fff; transform: translateY(-2px); }
  .sb-btn-inschrijf { background: #cb0c2a; color: #fff; }
  .sb-btn-inschrijf:hover { background: #a30a22; color: #fff; transform: translateY(-2px); }
  .sb-portret img { width: 100%; border-radius: 8px; }
  .sb-waarom ul { list-style: none; padding: 0; }
  .sb-waarom li {
    padding: 8px 0; border-bottom: 1px solid #f0ece6;
    font-size: 0.88rem; line-height: 1.5; color: #555;
  }
  .sb-waarom li:last-child { border-bottom: none; }
  .sb-waarom li a { font-weight: 500; }

  /* ============ PAGE HERO ============ */
  .page-hero {
    width: 100vw;
    margin-left: calc(-50vw + 50%);
    background: linear-gradient(rgba(0,0,0,0.4), rgba(0,0,0,0.5)),
                url('https://www.detheaterkamer.nl/wp-content/uploads/2021/01/flyer.acteren2.01.jpg');
    background-size: cover; background-position: center;
    padding: 60px 30px 50px; text-align: center;
    position: relative; overflow: hidden;
  }
  .page-hero::after {
    content: ''; position: absolute; bottom: 0; left: 0; right: 0; height: 6px;
    background: linear-gradient(90deg, #8b3a5c, #4a148c, #2c3e50);
  }
  .page-hero-label {
    font-size: 0.75rem; text-transform: uppercase; letter-spacing: 4px;
    color: #e7c654; margin-bottom: 10px; font-weight: 600;
  }
  .page-hero h1 {
    font-size: clamp(1.8rem, 3.5vw, 2.4rem); font-weight: 300; color: #fff;
    line-height: 1.15; margin-bottom: 10px;
  }
  .page-hero p {
    color: rgba(255,255,255,0.85); font-size: 1.05rem; line-height: 1.6;
    max-width: 620px; margin: 0 auto;
  }

  /* ============ SECTION TITLE ============ */
  .tk-section-title { text-align: center; margin-bottom: 8px; }
  .tk-section-title h2 {
    font-size: 1.5rem; color: #2c3e50; font-weight: 600;
    text-transform: uppercase; letter-spacing: 1px; margin-bottom: 8px;
  }
  .tk-title-bar { width: 60px; height: 3px; background: #cb0c2a; margin: 0 auto 20px; border-radius: 2px; }

  /* ============ CONTENT BLOCKS ============ */
  .content-block {
    background: #fff; border-radius: 12px; padding: 32px;
    margin-bottom: 24px; box-shadow: 0 2px 12px rgba(0,0,0,0.06);
    border: 1px solid #e8e2da;
  }
  .content-block h2 {
    font-size: 1.4rem; color: #2c3e50; margin-bottom: 16px;
    padding-bottom: 12px; border-bottom: 3px solid #8b3a5c;
    display: inline-block; font-weight: 700;
  }
  .content-block h3 {
    font-size: 1.15rem; color: #2c3e50; margin: 20px 0 10px; font-weight: 600;
  }
  .content-block p {
    color: #555; font-size: 1rem; line-height: 1.75; margin-bottom: 14px;
  }
  .content-block p:last-child { margin-bottom: 0; }

  /* ============ CTA BLOCK ============ */
  .cta-block {
    background: #2c3e50; border-radius: 12px; padding: 36px;
    text-align: center; margin: 32px 0;
  }
  .cta-block h2 {
    color: #e7c654; font-size: 1.4rem; margin-bottom: 12px;
  }
  .cta-block p { color: rgba(255,255,255,0.85); margin-bottom: 20px; }
  .cta-buttons { display: flex; justify-content: center; gap: 16px; flex-wrap: wrap; }
  .cta-btn {
    display: inline-block; padding: 14px 28px; border-radius: 8px;
    font-weight: 600; font-size: 1rem; transition: all 0.3s ease;
  }
  .cta-btn-primary { background: #cb0c2a; color: #fff; }
  .cta-btn-primary:hover { background: #a30a22; color: #fff; transform: translateY(-2px); }
  .cta-btn-secondary { background: #fff; color: #2c3e50; }
  .cta-btn-secondary:hover { background: #e7c654; color: #2c3e50; transform: translateY(-2px); }

  /* ============ TEACHER CARDS ============ */
  .teacher-grid {
    display: grid; grid-template-columns: repeat(2, 1fr);
    gap: 28px; margin: 28px 0;
  }
  .teacher-card {
    background: #fff; border-radius: 12px; overflow: hidden;
    box-shadow: 0 4px 16px rgba(0,0,0,0.08); border: 1px solid #e8e2da;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }
  .teacher-card:hover {
    transform: translateY(-4px); box-shadow: 0 12px 32px rgba(0,0,0,0.12);
  }
  .teacher-card img {
    width: 100%; height: 260px; object-fit: cover;
    border-bottom: 4px solid #8b3a5c;
  }
  .teacher-card-body { padding: 22px; }
  .teacher-card-body h3 {
    font-size: 1.3rem; color: #2c3e50; margin-bottom: 12px;
    padding-bottom: 10px; border-bottom: 1px solid #e8e2da;
  }
  .teacher-card-body p {
    color: #555; font-size: 0.95rem; line-height: 1.65; margin-bottom: 10px;
  }

  /* ============ CONTACT GRID ============ */
  .contact-grid {
    display: grid; grid-template-columns: 1fr 1fr;
    gap: 24px; margin: 24px 0;
  }
  .contact-card {
    background: #fff; border-radius: 12px; padding: 28px;
    box-shadow: 0 2px 12px rgba(0,0,0,0.06); border: 1px solid #e8e2da;
  }
  .contact-card h3 {
    font-size: 1.2rem; color: #2c3e50; margin-bottom: 16px;
    padding-bottom: 10px; border-bottom: 2px solid #e7c654;
  }
  .contact-card p {
    color: #555; font-size: 0.95rem; line-height: 1.7; margin-bottom: 10px;
  }
  .contact-card strong { color: #2c3e50; }
  .contact-card a { font-weight: 500; }

  .location-card {
    background: #f4f1ee; border-radius: 10px; padding: 24px;
    margin-bottom: 20px; border-left: 4px solid #2c3e50;
  }
  .location-card h3 {
    font-size: 1.15rem; color: #2c3e50; margin-bottom: 8px;
  }
  .location-card p {
    color: #666; font-size: 0.95rem; line-height: 1.6; margin-bottom: 6px;
  }
  .location-card a { font-weight: 500; }

  /* ============ FAQ ============ */
  .faq-item {
    background: #fff; border-radius: 12px; padding: 28px;
    margin-bottom: 20px; box-shadow: 0 2px 12px rgba(0,0,0,0.06);
    border: 1px solid #e8e2da; border-left: 4px solid #8b3a5c;
  }
  .faq-item h3 {
    font-size: 1.15rem; color: #2c3e50; margin-bottom: 8px; font-weight: 700;
  }
  .faq-item .faq-short {
    font-size: 0.95rem; color: #8b3a5c; font-weight: 500; margin-bottom: 12px;
    font-style: italic;
  }
  .faq-item p {
    color: #555; font-size: 0.95rem; line-height: 1.7; margin-bottom: 10px;
  }

  /* ============ QUOTE BAR ============ */
  .quote-bar {
    background: #efebe6; border-radius: 10px; padding: 24px 28px;
    margin: 28px 0; text-align: center;
  }
  .quote-bar p {
    font-style: italic; font-size: 1.1rem; color: #666699;
    font-family: 'Playfair Display', Georgia, serif;
  }
  .quote-bar cite {
    display: block; font-size: 0.85rem; margin-top: 6px; font-style: normal; color: #aaa;
  }

  /* ============ FOOTER ============ */
  .site-footer {
    background: #2c3e50; color: #fff; margin-top: 40px; padding: 40px 20px 20px;
  }
  .footer-inner {
    max-width: 1400px; margin: 0 auto;
    display: grid; grid-template-columns: repeat(4, 1fr); gap: 28px;
  }
  .footer-col h4 {
    color: #e7c654; font-size: 1rem; margin-bottom: 12px;
    font-family: 'Playfair Display', Georgia, serif;
  }
  .footer-col p, .footer-col li, .footer-col a {
    font-size: 0.88rem; color: rgba(255,255,255,0.75); line-height: 1.7;
  }
  .footer-col ul { list-style: none; }
  .footer-col a:hover { color: #e7c654; }
  .footer-btn {
    display: inline-block; margin-top: 10px; margin-right: 8px;
    padding: 8px 18px; border-radius: 6px;
    font-weight: 600; font-size: 0.85rem; background: #e7c654; color: #2c3e50;
  }
  .footer-btn:hover { background: #d4b445; color: #2c3e50; }
  .footer-btn-alt { background: #cb0c2a; color: #fff; }
  .footer-btn-alt:hover { background: #a30a22; color: #fff; }
  .footer-bottom {
    max-width: 1400px; margin: 24px auto 0; padding-top: 16px;
    border-top: 1px solid rgba(255,255,255,0.15);
    text-align: center; font-size: 0.8rem; color: rgba(255,255,255,0.4);
  }

  /* ============ RESPONSIVE ============ */
  @media (max-width: 900px) {
    .page-layout { grid-template-columns: 1fr; gap: 24px; }
    .sidebar {
      position: static;
      display: grid; grid-template-columns: 1fr 1fr; gap: 12px;
    }
    .teacher-grid { grid-template-columns: repeat(2, 1fr); }
    .contact-grid { grid-template-columns: 1fr; }
    .footer-inner { grid-template-columns: 1fr 1fr; }
  }

  @media (max-width: 768px) {
    .header-logo img { height: 70px; }
    .main-nav {
      display: none; position: absolute; top: 100%; left: 0; right: 0;
      background: #fff; padding: 12px 20px;
      border-bottom: 3px solid #e7c654; box-shadow: 0 8px 24px rgba(0,0,0,0.1);
    }
    .main-nav.open { display: block; }
    .main-nav .nav-list { flex-direction: column; gap: 0; }
    .sub-nav { position: static; box-shadow: none; padding-left: 16px; display: block; }
    .nav-toggle { display: block; }

    .page-hero { padding: 40px 16px 35px; }
    .page-layout { padding: 16px 10px; }
    .main-full { padding: 16px 10px; }
    .teacher-grid { grid-template-columns: 1fr; }
    .sidebar { grid-template-columns: 1fr; }
    .content-block { padding: 22px 18px; }
    .footer-inner { grid-template-columns: 1fr; gap: 20px; }
    .cta-buttons { flex-direction: column; align-items: center; }
  }
</style>

<script is:inline>
  document.getElementById('footerYear').textContent = new Date().getFullYear();
</script>

</body>
</html>
